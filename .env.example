# Password for the /admin panel
ADMIN_PASSWORD=change-me

# A GitHub Personal Access Token with "repo" scope (classic) or
# "Contents: Read and write" (fine-grained), used to commit updates
# to data/apps.json whenever you add/edit/delete an app in /admin.
GITHUB_TOKEN=

# Your repo in the form owner/repo, e.g. "yourname/app-store"
GITHUB_REPO=

# Branch to write to (usually main)
GITHUB_BRANCH=main
